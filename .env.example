# Configure these as secrets/environment variables in Coolify.
# Admin token used by the primary to write into the replica (full access).
QUACK_TOKEN=replace-with-a-long-random-secret-at-least-32-chars
# Token of the read-only user (port 9495): SELECT-only, enforced server-side.
# Used by the UI and by any external read-only client. Must differ from QUACK_TOKEN.
QUACK_READONLY_TOKEN=replace-with-a-different-long-random-secret
# Basic Auth credentials protecting the DuckDB UI (port 8080).
UI_USERNAME=duckdb
UI_PASSWORD=replace-with-a-strong-password-12-chars-min
